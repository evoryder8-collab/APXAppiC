    "Foods you log in FITR MAX on iPhone will be offered here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foods you log in FITR MAX on iPhone will be offered here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebensmittel, die du in FITR MAX auf dem iPhone erfasst, erscheinen hier."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Läbesmittel, wo du i FITR MAX ufem iPhone erfassisch, chömed da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alimentos que registres en FITR MAX en el iPhone aparecerán aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli alimenti che registri in FITR MAX su iPhone appariranno qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alimentos que registares no FITR MAX no iPhone aparecem aqui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのFITR MAXで記録した食品がここに表示されます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentele pe care le înregistrezi în FITR MAX pe iPhone vor apărea aici."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาหารที่คุณบันทึกใน FITR MAX บน iPhone จะแสดงที่นี่"
          }
        }
      }
    },
